# Local development only. Change credentials before any shared deployment.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=twincitysafe
POSTGRES_USER=twincity
POSTGRES_PASSWORD=twincity_local_dev
# Optional override. Leave blank to build the URL safely from POSTGRES_*.
DATABASE_URL=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional absolute websocket URL; blank uses same-origin /ws/realtime via Vite.
VITE_WS_URL=

# M3: sampled history, not 1 Hz writes
TELEMETRY_SAMPLE_INTERVAL_SECONDS=5
APP_ENV=development

# Explicit opt-in for competition controls on a production backend.
DEMO_MODE=false
# Development controls are hidden by default in the frontend.
VITE_ENABLE_DEV_CONTROLS=false

# Optional artifact paths for deployment/recovery checks; blank keeps supplied models.
ANOMALY_MODEL_PATH=
RISK_MODEL_DIR=
# 高德地图 JS API（Web 端）密钥。配置后六个业务页面可切换真实 GIS 底图。
VITE_AMAP_KEY=
# 高德地图 JS API 安全密钥。开发环境可直接配置；生产环境应通过服务端代理保护。
VITE_AMAP_SECURITY_JS_CODE=
# 默认关闭在线瓦片，确保断网比赛演示仍可运行；需要真实 OSM GIS 时设为 true。
VITE_ENABLE_ONLINE_GIS=false
