{
  "name": "twincitysafe-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:web3d": "node scripts/verify-web3d.cjs",
    "test:realtime": "node scripts/verify-realtime.cjs",
    "test:operation": "node scripts/verify-operation.cjs",
    "test:operation-state": "node scripts/verify-operation-state.cjs",
    "test:pipeline": "node scripts/verify-pipeline.cjs",
    "test:flood": "node scripts/verify-flood.cjs",
    "test:flood-state": "node scripts/verify-flood-state.cjs",
    "test:risk": "node scripts/verify-risk.cjs",
    "test:emergency": "node scripts/verify-emergency.cjs",
    "test:leak": "node scripts/verify-leak.cjs",
    "test:leak-state": "node scripts/verify-leak-state.cjs",
    "test:review-state": "node scripts/verify-review-state.cjs",
    "test:incident-lifecycle": "node scripts/verify-incident-lifecycle.cjs",
    "test:review": "node scripts/verify-review.cjs",
    "test:review-legacy": "node scripts/verify-review-legacy.cjs",
    "test:final-demo": "node scripts/verify-final-demo.cjs",
    "test:quality": "node scripts/verify-quality.cjs",
    "test:navigation": "node scripts/verify-navigation.cjs",
    "test:gis": "node scripts/verify-gis.cjs",
    "test:ui-light": "node scripts/verify-ui-light.cjs",
    "test:recovery": "node scripts/verify-system-recovery.cjs --run-isolated"
  },
  "dependencies": {
    "axios": "^1.12.0",
    "cesium": "^1.146.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.9.0",
    "pinia": "^3.0.0",
    "three": "^0.180.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-cesium": "^1.2.23",
    "vue-tsc": "^3.0.0"
  }
}
